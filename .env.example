# =====================================================================
# 실습용 환경 변수
#
# 이 파일을 복사해서 `.env.local`을 만듭니다.
#   Windows PowerShell:  Copy-Item .env.example .env.local
#   macOS, Linux:        cp .env.example .env.local
#
# `.env.local`은 Git에 올라가지 않습니다. 값은 채팅, 문서, 화면에
# 복사하지 않습니다.
# =====================================================================

# --- browser까지 내려가는 값 -----------------------------------------
# NEXT_PUBLIC_ 이 붙은 변수는 빌드할 때 코드 안에 그대로 박혀서
# 사용자의 browser까지 내려갑니다. 개발자 도구를 열면 누구나 볼 수
# 있습니다. 그래서 공개돼도 되는 값에만 붙입니다.
NEXT_PUBLIC_SITE_PASSWORD=1234grid

# --- server에만 남는 값 ----------------------------------------------
# NEXT_PUBLIC_ 이 없는 변수는 server에서 도는 코드만 읽습니다.
# browser로 내려가지 않습니다.
#
# 각자 만든 training DB의 연결 문자열을 붙여 넣습니다.
# Supabase: Project Settings -> Database -> Connection string -> URI
# 실제 서비스 DB와 Production DB는 여기에 넣지 않습니다.
DATABASE_URL=postgresql://사용자이름:비밀번호@호스트주소:5432/데이터베이스이름
